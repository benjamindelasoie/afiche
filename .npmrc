# @vercel/analytics is a multi-framework package (Next.js, SvelteKit, Nuxt,
# Astro all in one). It declares an OPTIONAL peer dependency on
# @sveltejs/kit so SvelteKit users get IDE hints, but @sveltejs/kit's own
# transitive peer chain ends at vite@^8, which collides with our
# vitest@2.1.9's peer requirement of vite@^5.
#
# We're on Next.js — nothing in our runtime touches SvelteKit and nothing
# in node_modules/@vercel/analytics/dist/ actually imports Svelte. The
# conflict is purely in npm's resolver of an optional peer we don't use.
#
# legacy-peer-deps=true reverts npm to v6-era resolution (warn-don't-error
# on optional-peer conflicts), which is exactly what this flag is intended
# for per npm's own documentation. Documenting it here so fresh
# `npm install` runs (CI, new clones, post-rm-rf-node_modules) Just Work
# without anyone needing to remember the --legacy-peer-deps flag.
#
# To revisit: if @vercel/analytics ever ships a Next.js-only variant
# (current package is intentionally multi-framework), or if the SvelteKit
# vite peer relaxes to ^5 || ^8, this can come out.
legacy-peer-deps=true
