# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite (dev only)
local.db
local.db-journal
local.db-wal
local.db-shm

# scheduled-scrape runtime artifacts (scripts/scrape-cron.sh)
.scrape-cron.log
.scrape-cron.out.log
.scrape-last-success

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# claude code internal session state (settings, scheduled tasks, etc.)
.claude/*
# ...but DO version-control the repo's own project skills. Installed/personal
# skills (ask-matt, teach, writing-beats, grill-*, …) stay local: ignore
# everything under skills/ except the checked-in project skills.
!.claude/skills/
.claude/skills/*
!.claude/skills/add-venue/

# agent tooling — local/personal, not versioned
.agents/
skills-lock.json
# gbrain worktree pin — holds a machine-local source id (gstack-code-<repo>-<hash>),
# so it must not travel between machines or worktrees. Written by `gbrain sources attach`.
.gbrain-source

# gstack /retro JSON snapshots — local trend tracking only
.context/

# tesseract.js cached language data (downloaded on first OCR run)
*.traineddata
*.traineddata.gz
