{
  "name": "afiche",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.prod -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.prod -- drizzle-kit studio",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed-cinemas": "dotenv -e .env.local -- tsx src/db/seed-cinemas.ts",
    "db:seed-cinemas:prod": "dotenv -e .env.prod -- tsx src/db/seed-cinemas.ts",
    "db:reset-programming": "dotenv -e .env.local -- tsx src/db/reset-programming.ts",
    "db:scrape": "dotenv -e .env.local -- tsx src/scrapers/run.ts",
    "db:rescrape": "npm run db:reset-programming && npm run db:scrape",
    "db:enrich": "dotenv -e .env.local -- tsx src/db/enrich.ts",
    "db:enrich:prod": "dotenv -e .env.prod -- tsx src/db/enrich.ts",
    "scrape:prod": "./scripts/scrape-prod.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "better-sqlite3": "^12.9.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.0.0-insiders.f7d2598",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
